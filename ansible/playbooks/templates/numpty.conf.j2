# NumPTY nginx config - generated by Ansible from template
# DO NOT EDIT MANUALLY - changes will be overwritten on next deploy
#
# 렌더링 모드는 ssl_enabled 변수로 결정 (configure-web.yml이 set):
#   - false : HTTP only (인증서 발급 전, certbot HTTP-01 challenge 가능)
#   - true  : HTTP -> HTTPS 강제 + HTTPS server block 활성

# ===== bff WebSocket upstream =====
# bff_private_ip는 워크플로우가 CFN Outputs에서 받아 group_vars/app/vars.yml에
# 주입한 값. 매 배포마다 EC2가 새 IP를 받아도 자동 반영.
upstream bff_websocket {
    server {{ bff_private_ip }}:3000;
}

# =====================================================================
# Port 80 (HTTP) - 항상 떠 있는 server block
# =====================================================================
# 두 가지 역할:
#   1. /.well-known/acme-challenge/* - Let's Encrypt HTTP-01 검증 통과
#      (이건 redirect 안 함. certbot이 placement한 challenge 파일 응답)
#   2. 나머지 - HTTPS로 redirect (ssl_enabled=true일 때만)
#
# ssl_enabled=false일 땐 80에서 다 서빙 (인증서 발급 전 임시 상태).
server {
    listen 80;
    server_name {{ domain_name }} {% for alias in domain_aliases %}{{ alias }} {% endfor %};

    # ----- acme-challenge - 인증서 발급/갱신 시 certbot이 쓰는 경로 -----
    # configure-web.yml의 acme_challenge_root와 같은 값이어야 함.
    # certbot이 여기에 challenge 파일을 두면 nginx가 그대로 응답.
    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type "text/plain";
    }

{% if ssl_enabled %}
    # ----- 그 외 모든 요청 - HTTPS로 강제 -----
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    # ----- 인증서 발급 전 상태 - HTTP에서 정적 파일 서빙 -----
    # 첫 배포 시 짧은 순간만 이 모드. 인증서 발급되면 즉시 ssl_enabled=true로 재배포.
    root {{ web_root | default('/opt/numpty/web') }};
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /ws {
        proxy_pass http://bff_websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
{% endif %}
}

{% if ssl_enabled %}
# =====================================================================
# Port 443 (HTTPS) - 실제 사용자 트래픽
# =====================================================================
# TLS termination이 여기서 일어남. 백엔드(bff)와는 평문 ws://.
# 사용자 브라우저는 wss://numpty.kr/ws로 접속하고, nginx가 그 wss를
# 풀어서 내부 ws로 bff에 전달.
server {
    listen 443 ssl;
    http2 on;
    server_name {{ domain_name }} {% for alias in domain_aliases %}{{ alias }} {% endfor %};

    # ----- TLS 인증서 (Let's Encrypt가 발급, 90일 자동 갱신) -----
    # certbot이 만든 live 디렉토리는 심볼릭 링크 - 갱신 시
    # nginx 설정 안 건드려도 새 인증서 자동 반영.
    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    # ----- 보안 설정 (Mozilla intermediate, 2024+) -----
    # TLS 1.2 / 1.3만. 1.0/1.1은 deprecated.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

    # session ticket 비활성 - forward secrecy 보장
    ssl_session_tickets off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS - 한 번 https로 들어온 브라우저는 1년간 http 시도 자체 안 함
    add_header Strict-Transport-Security "max-age=31536000" always;

    # ----- 정적 파일 루트 (vite build 결과물) -----
    root {{ web_root | default('/opt/numpty/web') }};
    index index.html;

    # ----- gzip 압축 -----
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ----- 정적 파일 + SPA fallback -----
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ----- WebSocket 프록시 -----
    # 브라우저 wss://numpty.kr/ws -> 여기 (TLS 종료) -> 내부 ws -> bff:3000
    location /ws {
        proxy_pass http://bff_websocket;

        # WebSocket 업그레이드
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 원본 정보 전달 - X-Forwarded-Proto=https로 백엔드도 TLS 인식
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 장시간 연결 유지 (터미널 세션)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
{% endif %}
